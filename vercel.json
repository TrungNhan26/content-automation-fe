{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/autopost/:path*",
      "destination": "https://autopost-worker.nathan-autopost.workers.dev/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://laptop-0dp7shta.tailbbd694.ts.net/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
